---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_ENABLED, SITE, SOCIALS } from '../../consts';
import { formatPostDate, postDateToISOString } from '../../lib/dates';
import { getPosts } from '../../lib/storyblok';

if (!BLOG_ENABLED) {
  return Astro.redirect('/');
}

const posts = await getPosts();
const dateFmt = (d: string) => formatPostDate(d);
const description =
  'Offensive security write-ups, bug bounty case studies, mobile research, web exploitation, and security engineering notes by Ibrahim Radi.';
const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;
const blogUrl = `${SITE.url}/blog/`;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${blogUrl}#blog`,
  name: 'Field Notes',
  description,
  url: blogUrl,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    '@id': personId,
    name: SITE.name,
    url: SITE.url,
    sameAs: [SOCIALS.github, SOCIALS.linkedin, SOCIALS.x],
  },
  publisher: { '@id': personId },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${SITE.url}/blog/${post.slug}/`,
    datePublished: postDateToISOString(post.date),
  })),
};

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${blogUrl}#page`,
  url: blogUrl,
  name: 'Field Notes',
  description,
  inLanguage: 'en-US',
  isPartOf: { '@id': websiteId },
  mainEntity: { '@id': `${blogUrl}#posts` },
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${blogUrl}#posts`,
  name: 'Offensive security articles',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${SITE.url}/blog/${post.slug}/`,
    name: post.title,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Field Notes', item: blogUrl },
  ],
};
---

<BaseLayout
  title="Offensive Security Field Notes"
  description={description}
  path="/blog/"
  jsonLd={[blogLd, collectionPageLd, itemListLd, breadcrumbLd]}
>
  <div class="doc">
    <section class="doc-hero" data-reveal>
      <div>
        <p class="dh-kicker">Dossier · <b>Field Notes</b></p>
        <h1 class="dh-name" style="font-size: clamp(2.2rem, 6vw, 3.4rem)">Field Notes</h1>
        <p class="dh-assess">
          Write-ups from the field: offensive security, tooling I had to build, and research worth keeping.
        </p>
      </div>
    </section>

    <section class="dsec" data-reveal>
      <div class="dsec-head">
        <span class="dsec-no">§</span><span class="dsec-title">Transmissions</span>
        <span class="dsec-meta">{posts.length} logged</span>
      </div>

      {posts.length === 0 ? (
        <div class="empty-state">No transmissions published yet. Check back soon.</div>
      ) : (
        <div class="notes">
          {posts.map((p) => (
            <a class="note" href={`/blog/${p.slug}/`}>
              <div class="note-top">
                <time datetime={p.date}>{dateFmt(p.date)}</time>
                {p.tags.length > 0 && <span class="note-tags">{p.tags.join(' · ')}</span>}
              </div>
              <h2 class="note-title">{p.title}</h2>
              {p.excerpt && <p class="note-ex">{p.excerpt}</p>}
              <span class="note-go">read →</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
