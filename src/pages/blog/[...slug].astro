---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_ENABLED, SITE, SOCIALS } from '../../consts';
import { formatPostDate, parsePostDate, postDateToISOString } from '../../lib/dates';
import { getPosts, getPost } from '../../lib/storyblok';

export async function getStaticPaths() {
  if (!BLOG_ENABLED) return [];
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
// Pages are pre-rendered from getStaticPaths props; re-fetch as a safety net.
const data = post ?? (await getPost(Astro.params.slug as string));
const html = data?.html ?? '';

const dateFmt = (d: string) => formatPostDate(d, { year: 'numeric', month: 'long', day: 'numeric' });
const dateShort = (d: string) => formatPostDate(d);
const isoDate = postDateToISOString(data?.date);
const postUrl = data ? `${SITE.url}/blog/${data.slug}/` : new URL(Astro.url.pathname, SITE.url).toString();
const blogUrl = `${SITE.url}/blog/`;
const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;
const wordCount = html
  ? html
      .replace(/<[^>]*>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .split(' ')
      .filter(Boolean).length
  : undefined;

// Recommended reading: rank other posts by shared tags, then recency.
const all = await getPosts();
const related = data
  ? all
      .filter((p) => p.slug !== data.slug)
      .map((p) => ({ p, score: p.tags.filter((t) => data.tags.includes(t)).length }))
      .sort((a, b) => b.score - a.score || parsePostDate(b.p.date).getTime() - parsePostDate(a.p.date).getTime())
      .slice(0, 3)
      .map((x) => x.p)
  : [];

const ogImage = data ? `${SITE.url}/og/${data.slug}.png` : `${SITE.url}/og.png`;

const articleLd = data && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  url: postUrl,
  headline: data.title,
  description: data.excerpt,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: 'en-US',
  image: ogImage,
  thumbnailUrl: ogImage,
  keywords: data.tags.join(', '),
  articleSection: data.tags[0] ?? 'Offensive Security',
  wordCount,
  about: data.tags.map((tag) => ({ '@type': 'Thing', name: tag })),
  author: {
    '@type': 'Person',
    '@id': personId,
    name: SITE.name,
    url: SITE.url,
    sameAs: [SOCIALS.github, SOCIALS.linkedin, SOCIALS.x],
  },
  publisher: { '@id': personId },
  isPartOf: [
    { '@type': 'Blog', '@id': `${blogUrl}#blog`, name: 'Field Notes', url: blogUrl },
    { '@type': 'WebSite', '@id': websiteId, name: SITE.name, url: `${SITE.url}/` },
  ],
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};

const breadcrumbLd = data && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Field Notes', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: data.title, item: postUrl },
  ],
};

const ld = [articleLd, breadcrumbLd].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout
  title={data?.title}
  description={data?.excerpt}
  path={`/blog/${data?.slug}/`}
  ogType="article"
  image={data ? `/og/${data.slug}.png` : undefined}
  imageAlt={data ? `${data.title} social preview` : undefined}
  publishedTime={isoDate}
  jsonLd={ld.length ? ld : undefined}
>
  <div class="doc post-shell">
    <article class="article post-article">
      <a class="back" href="/blog/">← field notes</a>
      <header class="article-header">
        <div class="meta">
          <time datetime={data?.date}>{dateFmt(data?.date ?? '')}</time>
          {data && data.tags.length > 0 && <span> · {data.tags.join(' · ')}</span>}
        </div>
        <h1>{data?.title}</h1>
      </header>
      <div class="article-body" set:html={html}></div>

      {related.length > 0 && (
        <nav class="related" aria-label="Recommended reading">
          <div class="related-head">// recommended reading</div>
          <div class="notes-mini">
            {related.map((p) => (
              <a class="note-mini" href={`/blog/${p.slug}/`}>
                <time datetime={p.date}>{dateShort(p.date)}</time>
                <span class="nm-title">{p.title}</span>
                <span class="nm-go">→</span>
              </a>
            ))}
          </div>
        </nav>
      )}
    </article>

    {data && data.toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <div class="toc-inner">
          <div class="toc-head">// on this page</div>
          <nav>
            <ol>
              {data.toc.map((t) => (
                <li><a href={`#${t.id}`}>{t.text}</a></li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
